{
  "name": "pq-workbench",
  "version": "0.3.0",
  "description": "Desktop app for executing Power Query (M code) against Microsoft Fabric workspaces",
  "main": "dist/main/main.js",
  "license": "MIT",
  "author": {
    "name": "Mihir Wagle",
    "email": "mihir@mavaali.com"
  },
  "repository": "https://github.com/mavaali/pq-workbench",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:renderer": "webpack serve --config webpack.renderer.config.js --mode development",
    "dev:main": "wait-on http://localhost:9000 && tsc -p tsconfig.main.json && electron dist/main/main.js",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "webpack --config webpack.renderer.config.js --mode production",
    "start": "electron dist/main/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.renderer.json",
    "test": "vitest",
    "test:run": "vitest run",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "build": {
    "appId": "com.mavaali.pq-workbench",
    "productName": "PQ Workbench",
    "files": [
      "dist/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@azure/msal-node": "^5.2.3",
    "@fabric-msft/svg-icons": "^8.0.1",
    "@fluentui/react-components": "^9.56.0",
    "@fluentui/react-icons": "^2.0.268",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@microsoft/powerquery-language-services": "^1.0.0",
    "@monaco-editor/react": "^4.7.0",
    "allotment": "^1.20.5",
    "apache-arrow": "^21.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "concurrently": "^9.1.2",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.2",
    "electron": "^33.3.1",
    "electron-builder": "^26.15.2",
    "html-webpack-plugin": "^5.6.3",
    "jsdom": "^29.1.1",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.7.3",
    "vitest": "^4.1.8",
    "wait-on": "^8.0.3",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0"
  }
}
